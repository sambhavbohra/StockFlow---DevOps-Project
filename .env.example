# Copy to .env (git-ignored) and replace every change-me value. Never commit .env.
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=stockflow

# Used by the backend and Alembic when running on your machine.
DATABASE_URL=postgresql+psycopg://stockflow:change-me@localhost:5432/stockflow

# Used only by pytest. The database name must end in _test (tests refuse to run otherwise).
# Create it once: docker compose exec db createdb -U stockflow stockflow_test
TEST_DATABASE_URL=postgresql+psycopg://stockflow:change-me@localhost:5432/stockflow_test
